__MWOPC_PART_BEGIN__ /simulink/stateflow/chart_83.xml
<?xml version="1.0" encoding="utf-8"?>
<chart id="83">
  <P Name="name">Plant/inverter_fault_model</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">83</P>
  <P Name="ssIdHighWaterMark">31</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">-1</P>
  <P Name="chartFileNumber">5</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">inverter_fault_model</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">83</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [Vu_gnd, Vv_gnd, Vw_gnd, Gate_U, Gate_V, Gate_W] = ...
    inverter_fault_model(Duty_u, Duty_v, Duty_w, Carrier, Vdc, Iu, Iv, Iw, Fault_U, Fault_V, Fault_W)
    % PWMスイッチング生成およびアーム故障模擬インバータモデル
    %
    % Inputs:
    %   Duty_u, _v, _w : デューティ指令 (0.0 ~ 1.0)
    %   Carrier        : 三角波キャリア信号 (0.0 ~ 1.0) ※外部のRepeating Sequence等で生成
    %   Vdc            : DCリンク電圧 [V]
    %   Iu, Iv, Iw     : モータの各相電流 [A] (還流ダイオードの挙動模擬に必須)
    %   Fault_U, _V, _W: 故障モードフラグ
    %                    0: 正常 (Normal)
    %                    1: 上アーム・オープン故障 (Stuck OFF)
    %                    2: 上アーム・ショート故障 (Stuck ON)
    %                    3: 下アーム・オープン故障 (Stuck OFF)
    %                    4: 下アーム・ショート故障 (Stuck ON)
    %
    % Outputs:
    %   Vu_gnd, _v, _w : 各相の対地電圧 [V] (これをモータモデルの中性点計算へ渡す)
    %   Gate_U, _V, _W : ゲート信号の実際の状態 [上アーム, 下アーム] (1=ON, 0=OFF) デバッグ用

    % 各相の処理を関数化して呼び出し
    [Vu_gnd, Gate_U] = calc_phase_voltage(Duty_u, Carrier, Vdc, Iu, Fault_U);
    [Vv_gnd, Gate_V] = calc_phase_voltage(Duty_v, Carrier, Vdc, Iv, Fault_V);
    [Vw_gnd, Gate_W] = calc_phase_voltage(Duty_w, Carrier, Vdc, Iw, Fault_W);

end

% --- ローカル関数：1相分のゲート信号と出力電圧を計算 ---
function [V_gnd, Gate_State] = calc_phase_voltage(Duty, Carrier, Vdc, I_phase, Fault_Mode)
    
    % 1. 理想的なゲート指令の生成 (デッドタイムは無視)
    % 【修正】比較結果(logical)を double 型(1 または 0) に変換します
    G_up_cmd  = double(Duty &gt;= Carrier);
    G_low_cmd = 1.0 - G_up_cmd;  % 上アームの反転 (1 -&gt; 0, 0 -&gt; 1)

    % 2. 故障の注入 (ゲート実際の状態)
    % 最初から double 型なので、後で 0 や 1 を代入してもエラーになりません
    G_up_act  = G_up_cmd;
    G_low_act = G_low_cmd;
    
    switch Fault_Mode
        case 1 % 上アーム・オープン故障 (常にOFF)
            G_up_act = 0;
        case 2 % 上アーム・ショート故障 (常にON)
            G_up_act = 1;
        case 3 % 下アーム・オープン故障 (常にOFF)
            G_low_act = 0;
        case 4 % 下アーム・ショート故障 (常にON)
            G_low_act = 1;
        otherwise % 0: 正常
            % 何もしない
    end
    
    % 3. スイッチ状態と電流方向に基づく出力電圧の決定
    % （ここから下の if - elseif は前回の修正版のままでOKです）
    if G_up_act == 1 &amp;&amp; G_low_act == 0
        % 上のみON -&gt; Vdc出力
        V_gnd = Vdc;
        
    elseif G_up_act == 0 &amp;&amp; G_low_act == 1
        % 下のみON -&gt; 0V出力 (GND)
        V_gnd = 0;
        
    elseif G_up_act == 0 &amp;&amp; G_low_act == 0
        % 上下OFF (デッドタイム中、またはオープン故障時)
        % 相電流の方向によって還流ダイオードの経路が変わる
        if I_phase &gt; 0
            % モータへ向かって電流が流れている -&gt; 下アームのダイオードを通って還流
            V_gnd = 0;
        else
            % インバータへ向かって電流が戻っている -&gt; 上アームのダイオードを通って還流
            V_gnd = Vdc;
        end
        
    else
        % 短絡 (アームショート・貫通)
        % 実際には素子破壊やヒューズ溶断が起きるが、シミュレーション上は0V(またはVdc/2)とする
        V_gnd = 0; 
    end
    
    % デバッグ出力用
    Gate_State = [G_up_act, G_low_act];
end</P>
      </eml>
    </state>
