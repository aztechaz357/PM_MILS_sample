<?xml version="1.0" encoding="utf-8"?>
<chart id="105">
  <P Name="name">Plant/pmsm_plant_model_v2</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">105</P>
  <P Name="ssIdHighWaterMark">21</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">-1</P>
  <P Name="chartFileNumber">6</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">pmsm_plant_model_abs</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">105</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [dIdp_dt, dIqp_dt] = pmsm_plant_model_abs(Vu_gnd, Vv_gnd, Vw_gnd, theta_rad, omega_rad_s, Idp, Iqp, R, Ld, Lq, Psi_a)
    % =========================================================================
    % 【連続系プラントモデル（絶対値変換 / 電力不変系）】
    % インバータモデルからの対地電圧を受け取り、電流の微分値(di/dt)を計算して
    % 外部の積分器ブロック(1/s)へ渡すためのモータモデルです。
    %
    % Inputs:
    %   Vu_gnd, Vv_gnd, Vw_gnd : インバータが出力する各相の対地電圧（GND基準） [V]
    %   theta_rad              : 現在のロータ電気角 [rad]
    %   omega_rad_s            : 現在のロータ電気角速度 [rad/s]
    %   Idp, Iqp               : 現在のd軸・q軸電流（※絶対値変換スケール） [A]
    %                            &lt;- 外部の積分器からフィードバックされる値
    %   R                      : 巻線抵抗 [Ohm]
    %   Ld, Lq                 : d軸・q軸インダクタンス [H]
    %   Psi_a                  : 永久磁石の鎖交磁束（※物理スケール） [Wb]
    %
    % Outputs:
    %   dIdp_dt, dIqp_dt       : d軸・q軸電流の変化率（※絶対値変換スケール） [A/s]
    %                            -&gt; 外部の積分器(1/s)へ渡す値
    % =========================================================================

    % 定数項の定義（最適化用）
    SQRT_3_2 = sqrt(1.5);
    SQRT_1_2 = sqrt(0.5);

    % --- 1. 中性点電圧の計算と相電圧への変換 ---
    % インバータから直接「対地電圧(V)」を受け取るため、Duty * Vdc の計算は不要です。
    % 3相の対地電圧の平均をとることで、スター結線モータの中性点電圧変動分を算出します。
    Vn_gnd = (Vu_gnd + Vv_gnd + Vw_gnd) / 3.0;
    
    % 対地電圧から中性点電圧を差し引き、モータコイルにかかる真の相電圧を求めます。
    Vu = Vu_gnd - Vn_gnd;
    Vv = Vv_gnd - Vn_gnd;
    Vw = Vw_gnd - Vn_gnd;

    % --- 2. 絶対値Clarke変換（三相物理スケール -&gt; 電力不変α-β） ---
    % 平衡三相(Vu+Vv+Vw=0)を前提に簡略化された絶対値変換式です。
    Valpha_p = SQRT_3_2 * Vu;
    Vbeta_p  = SQRT_1_2 * (Vv - Vw);
    
    % --- 3. Park変換（電力不変α-β -&gt; 電力不変d-q） ---
    cos_th = cos(theta_rad);
    sin_th = sin(theta_rad);
    Vdp = Valpha_p * cos_th + Vbeta_p * sin_th;
    Vqp = -Valpha_p * sin_th + Vbeta_p * cos_th;

    % --- 4. 鎖交磁束の絶対値変換 ---
    % 入力された物理パラメータ Psi_a を電力不変スケールに引き伸ばします。
    Psi_ap = SQRT_3_2 * Psi_a;

    % --- 5. 電圧方程式による電流変化率 (di_p/dt) の計算 ---
    % 外部の積分器からフィードバックされた現在の電流 Idp, Iqp を使用して微分値を算出します。
    dIdp_dt = (Vdp - R * Idp + omega_rad_s * Lq * Iqp) / Ld;
    dIqp_dt = (Vqp - R * Iqp - omega_rad_s * Ld * Idp - omega_rad_s * Psi_ap) / Lq;
end</P>
      </eml>
    </state>
    <data SSID="4" name="Vu_gnd">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="dIdp_dt">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="Vv_gnd">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="7" name="Vw_gnd">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="9" name="theta_rad">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="8" name="omega_rad_s">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="10" name="Idp">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="11" name="Iqp">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="17" name="R">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="12" name="dIqp_dt">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="13" name="Ld">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
