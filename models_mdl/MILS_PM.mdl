<?xml version="1.0" encoding="utf-8"?>
<chart id="53">
  <P Name="name">SystemControl/Trigger_Generator</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">53</P>
  <P Name="ssIdHighWaterMark">9</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">dt</P>
  <P Name="chartFileNumber">3</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">task_triggers</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">53</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [trig_carrier, trig_1ms, trig_5ms, trig_10ms] = task_triggers(dt, fc)
    % TASK_TRIGGERS 各周期タスクのトリガ(boolean)を生成する
    %   基本サンプル時間 dt 毎に呼ばれ、カウンタで各周期の立ち上がりを生成する。
    %   ※このブロックのサンプル時間は dt に設定すること。
    %
    % [入力]
    %   dt : 基本サンプル時間 [s]
    %   fc : キャリア周波数 [Hz]
    %
    % [出力]
    %   trig_carrier : キャリア周期トリガ
    %   trig_1ms     : 1ms 周期トリガ
    %   trig_5ms     : 5ms 周期トリガ
    %   trig_10ms    : 10ms 周期トリガ
    %#codegen

    % ==========================================
    % 1. 周期設定
    % ==========================================
    Ts        = dt;       % 基本サンプル時間
    T_carrier = 1 / fc;   % キャリア周期

    % ==========================================
    % 2. カウンタ(永続変数)の初期化
    % ==========================================
    persistent cnt_carrier cnt_1ms cnt_5ms cnt_10ms
    if isempty(cnt_carrier)
        cnt_carrier = uint32(0);
        cnt_1ms     = uint32(0);
        cnt_5ms     = uint32(0);
        cnt_10ms    = uint32(0);
    end

    % ==========================================
    % 3. 各周期の閾値(何ステップでトリガを立てるか)
    % ==========================================
    thresh_carrier = uint32(round(T_carrier / Ts));
    thresh_1ms     = uint32(round(0.001 / Ts));
    thresh_5ms     = uint32(round(0.005 / Ts));
    thresh_10ms    = uint32(round(0.010 / Ts));

    % ==========================================
    % 4. トリガ判定 (閾値到達で true、カウンタリセット)
    % ==========================================
    cnt_carrier = cnt_carrier + 1;
    if cnt_carrier &gt;= thresh_carrier
        trig_carrier = true;
        cnt_carrier  = uint32(0);
    else
        trig_carrier = false;
    end

    cnt_1ms = cnt_1ms + 1;
    if cnt_1ms &gt;= thresh_1ms
        trig_1ms = true;
        cnt_1ms  = uint32(0);
    else
        trig_1ms = false;
    end

    cnt_5ms = cnt_5ms + 1;
    if cnt_5ms &gt;= thresh_5ms
        trig_5ms = true;
        cnt_5ms  = uint32(0);
    else
        trig_5ms = false;
    end

    cnt_10ms = cnt_10ms + 1;
    if cnt_10ms &gt;= thresh_10ms
        trig_10ms = true;
        cnt_10ms  = uint32(0);
    else
        trig_10ms = false;
    end

end
</P>
        <P Name="editorLayout" Class="double">Matrix(4,1)
[10.0, 5.0, 700.0, 500.0]</P>
      </eml>
    </state>
    <data SSID="4" name="dt">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="5" name="trig_carrier">
      <P Name="scope">OUTPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_NO</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="6" name="fc">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
