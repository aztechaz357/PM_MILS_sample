<?xml version="1.0" encoding="utf-8"?>
<chart id="123">
  <P Name="name">Plant/current_dq_to_uvw_abs</P>
  <P Name="windowPosition">[422 539.941 189 413]</P>
  <P Name="viewLimits">[0 156.75 0 153.75]</P>
  <P Name="screen">[1 1 3600 1200 1.180555555555556]</P>
  <P Name="viewObj">123</P>
  <P Name="ssIdHighWaterMark">22</P>
  <P Name="decomposition">CLUSTER_CHART</P>
  <P Name="type">EML_CHART</P>
  <P Name="updateMethod">DISCRETE</P>
  <P Name="sampleTime">-1</P>
  <P Name="chartFileNumber">7</P>
  <P Name="disableImplicitCasting">1</P>
  <eml>
    <P Name="name">current_dq_to_uvw_abs</P>
  </eml>
  <Children>
    <state SSID="1">
      <P Name="labelString">eML_blk_kernel()</P>
      <P Name="position">[18 64.5 118 66]</P>
      <P Name="fontSize">12</P>
      <P Name="superState">SUBCHART</P>
      <P Name="subviewer">123</P>
      <P Name="type">FUNC_STATE</P>
      <P Name="decomposition">CLUSTER_STATE</P>
      <eml>
        <P Name="isEML">1</P>
        <P Name="script">function [Iu, Iv, Iw] = current_dq_to_uvw_abs(Idp, Iqp, theta_rad)
    % =========================================================================
    % 【絶対値変換版】d-q軸電流 -&gt; U-V-W相電流 変換モデル
    % 電力不変スケールのIdp, Iqpを、物理スケールの相電流に復元します。
    %
    % Inputs:
    %   Idp, Iqp  : d軸・q軸電流（※絶対値変換スケール） [A]
    %   theta_rad : 現在のロータ電気角 [rad]
    %
    % Outputs:
    %   Iu, Iv, Iw: 物理的な各相電流（インバータモデルの還流判定用） [A]
    % =========================================================================

    % 1. 逆Park変換 (Idp, Iqp -&gt; Ialpha_p, Ibeta_p)
    cos_th = cos(theta_rad);
    sin_th = sin(theta_rad);
    
    Ialpha_p = Idp * cos_th - Iqp * sin_th;
    Ibeta_p  = Idp * sin_th + Iqp * cos_th;

    % 2. 絶対値・逆Clarke変換 (Ialpha_p, Ibeta_p -&gt; Iu, Iv, Iw)
    % 定数項の定義（最適化用）
    % K1 = sqrt(2/3)
    % K2 = -0.5 * sqrt(2/3)
    % K3 = (sqrt(3)/2) * sqrt(2/3) = sqrt(2)/2
    K1 = sqrt(2/3);
    K2 = K1 * -0.5;
    K3 = sqrt(2) / 2;

    Iu = K1 * Ialpha_p;
    Iv = K2 * Ialpha_p + K3 * Ibeta_p;
    Iw = K2 * Ialpha_p - K3 * Ibeta_p;
end</P>
      </eml>
    </state>
    <data SSID="10" name="Idp">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
        </array>
        <type>
          <P Name="method">SF_INHERITED_TYPE</P>
          <P Name="primitive">SF_DOUBLE_TYPE</P>
          <P Name="isSigned">1</P>
          <P Name="wordLength">16</P>
        </type>
        <P Name="complexity">SF_COMPLEX_INHERITED</P>
        <P Name="frame">SF_FRAME_INHERITED</P>
        <unit>
          <P Name="name">inherit</P>
        </unit>
      </props>
      <P Name="dataType">Inherit: Same as Simulink</P>
    </data>
    <data SSID="11" name="Iqp">
      <P Name="scope">INPUT_DATA</P>
      <props>
        <array>
          <P Name="size">-1</P>
